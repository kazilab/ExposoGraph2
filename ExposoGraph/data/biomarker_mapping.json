    "manuscript_context": "v6 Methods / Exposure integration module: 'Supplementary Table S1 provides the complete mapping of Tier 2 lifestyle multipliers to their primary biomarker data sources, published concentration ranges, and derived [S]/Km ratios.'",
    "version": "1.0.0",
    "created": "2026-04-20",
    "schema": {
      "biomarker": "Urinary / blood / serum biomarker used for reverse dosimetry",
      "matrix": "Biospecimen matrix measured (urine, whole_blood, serum, plasma, exhaled_breath)",
      "reference_range": "Published population central range for the biomarker",
      "reference_units": "Units of the reference_range",
      "partition_coefficient": "Matrix→tissue conversion factor used in the PBPK step",
      "target_tissue": "Tissue used for [S] conversion",
      "target_enzyme": "Primary metabolizing enzyme whose Km is used for normalization",
      "Km_uM": "Km value used in the denominator of the [S]/Km ratio",
      "S_over_Km_central": "Central [S]/Km ratio used by the interaction / flux engines at Tier 2 baseline",
      "S_over_Km_range": "Minimum and maximum [S]/Km ratios across the published reference range",
      "tier2_multiplier": "Tier 2 lifestyle multiplier applied to the central [S]/Km ratio",
      "references": "PubMed IDs / dataset identifiers backing the biomarker central range and partition coefficient"
    }
  },
