  "_metadata": {
    "description": "Data-driven proxy and receptor-mediated parameter blocks for ExposoGraph flux modeling. These values are heuristic or semi-quantitative scaffolds for manuscript classes lacking full substrate-specific Michaelis-Menten calibration in kinetic_parameters.json.",
    "version": "1.0.0",
    "created": "2026-04-20",
    "schema": {
      "model_kind": "proxy class family",
      "exposure_default": "Where the default substrate or damage burden should be sourced from",
      "activation_terms": "Activation or damage-burden terms contributing to total_activation",
      "detox_terms": "Clearance, conjugation, feedback, or repair terms contributing to total_detox",
      "repair_terms": "Repair-capacity terms scaled from total activation burden"
    }
  },
