  "exposure_questionnaire_schema": {
    "sections": {
      "smoking": {
        "label": "Tobacco Use",
        "questions": [
          {"id": "smoking_status", "text": "Do you currently smoke cigarettes?", "type": "select", "options": ["never", "former", "current"]},
          {"id": "cigarettes_per_day", "text": "If current/former smoker: cigarettes per day at peak?", "type": "number", "unit": "cigarettes/day"},
          {"id": "pack_years", "text": "Estimated pack-years (packs/day × years)?", "type": "number", "unit": "pack-years"},
          {"id": "secondhand_smoke", "text": "Regular secondhand smoke exposure (home/work)?", "type": "boolean"}
        ]
      },
      "alcohol": {
        "label": "Alcohol Consumption",
        "questions": [
          {"id": "alcohol_status", "text": "Do you drink alcohol?", "type": "select", "options": ["nondrinker", "light", "moderate", "heavy"]},
          {"id": "drinks_per_week", "text": "Approximate drinks per week (1 drink = 14g ethanol)?", "type": "number", "unit": "drinks/week"},
          {"id": "binge_episodes", "text": "Binge drinking episodes per month (≥5 drinks/occasion men, ≥4 women)?", "type": "number", "unit": "episodes/month"}
        ]
      },
      "diet": {
        "label": "Dietary Exposures",
        "questions": [
          {"id": "grilled_meat_frequency", "text": "How often do you eat grilled/charred meats?", "type": "select", "options": ["never", "monthly", "weekly", "daily"]},
          {"id": "processed_meat_frequency", "text": "How often do you eat processed meats (hotdogs, sausage, bacon, deli meats)?", "type": "select", "options": ["never", "monthly", "weekly", "daily"]},
          {"id": "red_meat_servings", "text": "Red meat servings per week?", "type": "number", "unit": "servings/week"},
          {"id": "seafood_frequency", "text": "Fish/seafood servings per week?", "type": "number", "unit": "servings/week"},
          {"id": "aflatoxin_exposure", "text": "Do you live in or travel frequently to regions with high aflatoxin exposure (parts of Africa, South/Southeast Asia)?", "type": "boolean"}
        ]
      },
      "occupation": {
        "label": "Occupational Exposures",
        "questions": [
          {"id": "occupation_category", "text": "Which best describes your occupation?", "type": "select", "options": ["office_indoor", "healthcare", "agriculture", "construction_outdoor", "manufacturing_industrial", "petroleum_chemical", "mining_metals", "dry_cleaning_solvents", "firefighting", "funeral_embalming", "other"]},
          {"id": "occupation_years", "text": "Years in current or most hazardous occupation?", "type": "number", "unit": "years"},
          {"id": "occupational_chemicals", "text": "Have you had occupational exposure to any of these?", "type": "multiselect", "options": ["PAHs_coke_oven", "benzene_petroleum", "chromium_vi", "arsenic", "cadmium_batteries", "formaldehyde", "TCE_solvents", "PCBs_dioxins", "asbestos", "coal_dust", "diesel_exhaust", "none"]},
          {"id": "ppe_use", "text": "Did/do you use personal protective equipment consistently?", "type": "select", "options": ["always", "usually", "sometimes", "rarely", "never"]}
        ]
      },
      "residential": {
        "label": "Residential Environment",
        "questions": [
          {"id": "urban_rural", "text": "Primary residential environment?", "type": "select", "options": ["urban_high_traffic", "urban_typical", "suburban", "rural_agricultural", "rural_low_exposure"]},
          {"id": "proximity_industrial", "text": "Within 1 mile of industrial facility, power plant, or hazardous waste site?", "type": "boolean"},
          {"id": "water_source", "text": "Primary drinking water source?", "type": "select", "options": ["municipal_treated", "well_water_tested", "well_water_untested", "bottled_water"]},
          {"id": "arsenic_endemic_area", "text": "Well water in area with known arsenic contamination?", "type": "boolean"},
          {"id": "indoor_air_quality", "text": "Home built before 1980 or significant renovation with new materials?", "type": "boolean"},
          {"id": "sun_exposure", "text": "Average outdoor sun exposure?", "type": "select", "options": ["minimal", "moderate", "high_outdoor_worker", "tanning_bed_user"]}
        ]
      }
    }
  },

  "flux_model_integration": {
    "description": "How to combine ExposoGraph flux ratios with exposure data",
    "formula": "exposure_weighted_risk = flux_ratio × exposure_multiplier",
    "flux_ratio_definition": "Activation_Score / Detoxification_Score computed by ExposoGraph from patient genotypes",
    "baseline_flux_ratio": 1.0,
    "risk_thresholds": {
      "low": {"max": 0.8, "label": "Reduced Risk", "color": "green"},
      "average": {"min": 0.8, "max": 2.0, "label": "Population Average Risk", "color": "yellow"},
      "elevated": {"min": 2.0, "max": 10.0, "label": "Elevated Risk", "color": "orange"},
      "high": {"min": 10.0, "label": "High Risk", "color": "red"}
    },
