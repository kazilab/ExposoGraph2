{
  "metadata": {
    "title": "ExposoGraph Exposure Integration Database",
    "version": "1.0.0",
    "date": "2026-03-30",
    "authors": ["Kenneth J. Pienta (Johns Hopkins University)", "Julhash U. Kazi (Lund University)"],
    "sources": [
      "NHANES 2007-2018 (CDC/NCHS)",
      "EPA IRIS (Integrated Risk Information System)",
      "ATSDR (Agency for Toxic Substances and Disease Registry)",
      "FDA Total Diet Study",
      "OSHA Permissible Exposure Limits",
      "NIOSH Recommended Exposure Limits",
      "NIAAA 2023 NSDUH",
      "IARC Monographs (Volumes 100A-100F, 132)",
      "PMID:15322857 (NHANES 1-OHPyr)",
      "PMID:11477514 (US HCA intake)",
      "Taylor & Francis 2024 (Dietary Nitrosamines)"
    ],
    "description": "Population-level exposure data for all 14 ExposoGraph carcinogen classes. Provides exposure scenarios (from unexposed to occupational high), biomarker reference values, estimated tissue concentrations, and regulatory benchmarks for integration with genotype-based flux scoring.",
    "units_note": "tissue_conc_uM = estimated target tissue or blood concentration in micromolar; daily_intake_ug_kg = daily intake in micrograms per kilogram body weight",
    "genotype_modifier_note": "Genotype modifiers are applied multiplicatively: flux_ratio (from ExposoGraph) × exposure_multiplier = combined risk score"
  },
  "carcinogen_classes": {
    "PAH": {
      "class_id": 1,
      "class_label": "A. Polycyclic Aromatic Hydrocarbons (PAHs)",
      "index_carcinogen": "Benzo[a]pyrene (BaP)",
      "iarc_classification": "Group 1",
      "primary_targets": ["Lung", "Skin", "Bladder", "Colon"],
      "key_enzymes_activation": ["CYP1A1", "CYP1B1", "EPHX1"],
      "key_enzymes_detox": ["GSTM1", "GSTT1", "GSTP1", "UGT1A1"],
      "exposure_scenarios": {
        "unexposed": {
          "label": "Minimal exposure (rural non-smoker, no occupational)",
          "estimated_tissue_conc_uM": 0.001,
          "daily_intake_ug_kg": 0.001,
          "multiplier_vs_baseline": 0.2,
          "source": "ATSDR; EPA background estimates"
        },
        "general_population": {
          "label": "Typical US adult (non-smoker, urban)",
          "biomarker": "Urinary 1-OHPyr 79.8 ng/L (74.2 ng/g creatinine)",
          "estimated_tissue_conc_uM": 0.005,
          "daily_intake_ug_kg": 0.005,
          "multiplier_vs_baseline": 1.0,
          "air_concentration_ng_m3": 2.0,
          "source": "NHANES 1999-2000; PMID:15322857"
        },
        "smoker": {
          "label": "Current smoker (1 pack/day, ~20 cigarettes)",
          "estimated_tissue_conc_uM": 0.015,
          "daily_intake_ug_kg": 0.015,
          "multiplier_vs_baseline": 3.0,
          "note": "Cigarette smoke major PAH source; 1-OHPyr ~3x higher in smokers vs non-smokers",
          "source": "NHANES; ATSDR ToxProfile PAH"
        },
        "heavy_grilled_meat_diet": {
          "label": "Daily grilled/charred meat consumer",
          "estimated_tissue_conc_uM": 0.010,
          "daily_intake_ug_kg": 0.010,
          "multiplier_vs_baseline": 2.0,
          "dietary_bap_ug_day": 0.3,
          "note": "Grilled/charred meat 0.1-10 ng/g BaP; total dietary BaP ~0.1-0.4 μg/day typical US diet",
          "source": "FDA Total Diet Study"
        },
        "smoker_heavy_grilled_meat": {
          "label": "Smoker + daily grilled/charred meat diet",
          "estimated_tissue_conc_uM": 0.035,
          "daily_intake_ug_kg": 0.035,
          "multiplier_vs_baseline": 7.0,
          "source": "Combined smoking + dietary PAH estimates"
        },
        "occupational_high": {
          "label": "Coke oven / foundry / road paving worker",
          "estimated_tissue_conc_uM": 0.5,
          "daily_intake_ug_kg": 0.5,
          "multiplier_vs_baseline": 100.0,
          "air_concentration_ng_m3": 200.0,
          "note": "Occupational PAH 10-100x general population; 1-OHPyr >1000 ng/g creatinine in coke oven workers",
          "source": "OSHA; occupational cohort studies; NIOSH"
        }
      },
      "epa_cancer_slope_factor": {
        "value": 1.0,
        "unit": "per mg/kg-day",
        "adaf_adjusted_value": 2.0,
        "source": "EPA IRIS; CASRN 50-32-8"
      },
      "epa_inhalation_unit_risk": {
        "value": 1e-3,
        "unit": "per μg/m³",
        "source": "EPA IRIS"
      },
      "regulatory_limits": {
        "OSHA_PEL_coal_tar_pitch_volatiles": "0.2 mg/m³ (cyclohexane-soluble fraction)",
        "NIOSH_REL_coke_oven_emissions": "lowest feasible concentration",
        "EPA_ambient_air_guidance": "no safe level; minimize exposure"
      },
      "population_prevalence_notes": "Urban air: 0.2-20 ng/m³; Rural: 0.1-1 ng/m³. Dietary BaP 0.1-0.4 μg/day typical US adult"
    },

    "HCA": {
      "class_id": 2,
      "class_label": "B. Heterocyclic Amines (HCAs)",
