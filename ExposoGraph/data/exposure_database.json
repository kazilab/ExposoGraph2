      "key_enzymes_activation": ["CYP1A2", "SULT1A1", "NAT2"],
      "key_enzymes_detox": ["NAT2", "UGT1A1", "GSTP1"],
      "exposure_scenarios": {
        "vegetarian_low_meat": {
          "label": "Vegetarian / very low meat intake",
          "estimated_tissue_conc_uM": 0.0005,
          "daily_intake_ng_person": 50,
          "daily_intake_ng_kg": 0.5,
          "multiplier_vs_baseline": 0.1,
          "source": "PMID:11477514"
        },
        "general_population": {
          "label": "Average US adult (mixed diet)",
          "biomarker": "Urinary PhIP metabolites; estimated ~9 ng/kg/day total HA",
          "estimated_tissue_conc_uM": 0.005,
          "daily_intake_ng_person": 554,
          "daily_intake_ng_kg": 9.0,
          "multiplier_vs_baseline": 1.0,
          "phip_fraction": 0.68,
          "note": "US population average total HA intake ~9 ng/kg/day; PhIP ~67-70% of total",
          "source": "PMID:11477514; Pan et al. 2011"
        },
        "moderate_meat_diet": {
          "label": "Moderate meat eater (daily chicken/beef)",
          "estimated_tissue_conc_uM": 0.025,
          "daily_intake_ng_person": 2000,
          "daily_intake_ng_kg": 28,
          "multiplier_vs_baseline": 3.0,
          "source": "NCI HCA estimation tool; PMID:11477514"
        },
        "high_meat_well_done": {
          "label": "High red meat consumer, well-done/pan-fried",
          "estimated_tissue_conc_uM": 0.08,
          "daily_intake_ng_person": 8000,
          "daily_intake_ng_kg": 100,
          "multiplier_vs_baseline": 10.0,
          "note": "Pan-fried meats largest source; well-done chicken highest PhIP levels (per NCI food preparation studies)",
          "source": "NCI HCA database; Sinha et al. 2005"
        }
      },
      "epa_cancer_slope_factor": {
        "value": null,
        "note": "No EPA IRIS entry for PhIP specifically; EFSA 2015 reviewed HCAs",
        "source": "EFSA 2015 risk assessment on HCAs in cooked meat"
      },
      "regulatory_limits": {
        "note": "No specific regulatory limits for HCAs in food; FDA monitors via Total Diet Study"
      },
      "exposure_categories_from_literature": {
        "low": "<3 ng/kg/day",
        "moderate": "3-15 ng/kg/day",
        "high": ">15 ng/kg/day"
      }
